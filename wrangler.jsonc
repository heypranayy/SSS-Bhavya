{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bhavya-fashions",
  // tech.gexart@gmail.com Cloudflare account
  "account_id": "8af4b0b1475268d847835db412045fde",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  // Backup address: https://bhavya-fashions.tech-gexart.workers.dev
  "workers_dev": true,
  // Cloudflare creates the DNS records and certificates for these.
  "routes": [
    { "pattern": "bhavyafashions.com", "custom_domain": true },
    { "pattern": "www.bhavyafashions.com", "custom_domain": true }
  ],
  // All app data (products, catalogs, customers, inquiries, staff logins, sessions). Schema: migrations/
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bhavya-fashions-db",
      "database_id": "b04e8c76-79c4-4f0f-abec-38466e76a10b",
      "migrations_dir": "migrations"
    }
  ],
  // Uploaded and migrated product images, served by the Worker at /media/<key>
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "bhavya-fashions-media"
    }
  ]
}
